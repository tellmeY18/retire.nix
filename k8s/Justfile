    kubectl get pod rustfs-0 -n rustfs-clusters -o jsonpath='{.status.containerStatuses[0].ready}{"\n"}'
    @echo "Service endpoints:"
    kubectl get endpoints rustfs-storage-io -n rustfs-clusters

