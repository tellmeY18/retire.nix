# k8s/Justfile — recipes for the glug-infra cluster.
#
# Invoke from the repo root via the `k8s` module:
#   just k8s              # list these recipes
#   just k8s::apply       # apply everything
# or directly from this directory:
#   cd k8s && just apply
#
# Why a separate Justfile?
#   helm-secrets resolves `secrets://...` URLs in helmfile.yaml relative to
#   the CURRENT WORKING DIRECTORY. By making `k8s/` the working directory
#   for every recipe in this file we avoid sprinkling `cd k8s &&` over each
#   helmfile invocation, and let users in the k8s/ subtree drive everything
#   without typing `--file ../helmfile.yaml`.
#
# Pin the working directory so all recipes (helmfile, kubectl -k, sops)
# resolve relative paths against `k8s/` regardless of where `just` is run.
set working-directory := '.'

# List available commands
default:
    @just --list

# ---------------------------------------------------------------------------
# Apply / diff / template
# ---------------------------------------------------------------------------

# Apply all k8s cluster resources (kustomize + helmfile).
#
# Order matters:
#   1. kustomize creates the cnpg-clusters namespace (with PSA labels),
#      network policies, and the Tailscale LoadBalancer Service.
#      It also creates the monitoring namespace and the Grafana Tailscale
#      Service.
#   2. helmfile installs/upgrades the CNPG operator first (CRDs + controller),
#      then the postgres cluster release (which needs the namespace from step 1
#      and the CRDs from the operator).
[doc('Apply kustomize + helmfile to the cluster')]
apply:
    kubectl apply -k clusters/glug-infra
    kubectl apply -k clusters/glug-infra/pxc
    kubectl apply -k clusters/glug-infra/monitoring
    helmfile sync

# Preview k8s changes without applying.
[doc('Preview kustomize + helmfile changes (no apply)')]
diff:
    kubectl diff -k clusters/glug-infra || true
    kubectl diff -k clusters/glug-infra/pxc || true
    kubectl diff -k clusters/glug-infra/monitoring || true
    helmfile diff

# Render the fully-merged helm output (values.yaml + decrypted secrets.yaml)
# without touching the cluster. Useful to confirm sensitive overrides are
# coming through before the first apply.
[doc('Render merged helm output (values + decrypted secrets)')]
template:
    helmfile template

# ---------------------------------------------------------------------------
# Secrets
# ---------------------------------------------------------------------------

# Edit a sops-encrypted secret file (path is relative to k8s/).
# Examples:
#   just k8s::edit-secret apps/postgres/secrets.yaml
#   just k8s::edit-secret apps/cnpg-operator/secrets.yaml
[doc('Open a sops-encrypted file in $EDITOR')]
edit-secret path:
    sops {{ path }}

# Encrypt a plaintext values file in place (first-time setup only).
# After this runs, use `edit-secret` for subsequent edits.
# Example:
#   just k8s::encrypt-secret apps/cnpg-operator/secrets.yaml
[doc('Encrypt a plaintext values file in place (first-time)')]
encrypt-secret path:
    sops --encrypt --in-place {{ path }}

# ---------------------------------------------------------------------------
# CNPG day-2 helpers
# ---------------------------------------------------------------------------
# All assume the kubectl-cnpg plugin is installed:
#   kubectl krew install cnpg

# Show the CNPG cluster status.
cnpg-status:
    kubectl cnpg status postgres -n cnpg-clusters

# Tail logs from the CNPG operator.
cnpg-operator-logs:
    kubectl logs -n cnpg-system -l app.kubernetes.io/name=cloudnative-pg -f --tail=200

# Tail logs from the current CNPG primary.
cnpg-primary-logs:
    kubectl logs -n cnpg-clusters -l cnpg.io/cluster=postgres,role=primary -f --tail=200

# Trigger an on-demand backup.
cnpg-backup-now:
    kubectl cnpg backup postgres -n cnpg-clusters

# List Backup objects with their phase.
cnpg-backup-list:
    kubectl get backup -n cnpg-clusters \
      -o custom-columns=NAME:.metadata.name,PHASE:.status.phase,STARTED:.status.startedAt,STOPPED:.status.stoppedAt

# ---------------------------------------------------------------------------
# PXC (Percona XtraDB Cluster) day-2 helpers
# ---------------------------------------------------------------------------

# Show PXC cluster status.
[doc('Show Percona XtraDB Cluster status')]
pxc-status:
    kubectl get pxc mysql -n pxc-clusters -o wide

# Show detailed PXC cluster info.
[doc('Show detailed PXC cluster description')]
pxc-describe:
    kubectl describe pxc mysql -n pxc-clusters

# Tail logs from the PXC operator.
[doc('Tail PXC operator logs')]
pxc-operator-logs:
    kubectl logs -n pxc-system -l app.kubernetes.io/name=pxc-operator -f --tail=200

# Tail logs from the PXC primary (writer) node.
[doc('Tail PXC primary node logs')]
pxc-primary-logs:
    kubectl logs -n pxc-clusters mysql-pxc-0 -c pxc -f --tail=200

# Tail HAProxy logs.
[doc('Tail PXC HAProxy logs')]
pxc-haproxy-logs:
    kubectl logs -n pxc-clusters -l app.kubernetes.io/component=haproxy,app.kubernetes.io/instance=mysql -f --tail=200

# Show all PXC pods and their status.
[doc('List all PXC pods')]
pxc-pods:
    kubectl -n pxc-clusters get pods -l app.kubernetes.io/instance=mysql -o wide

# List PXC backup objects.
[doc('List PXC backup objects')]
pxc-backup-list:
    kubectl get pxc-backup -n pxc-clusters \
      -o custom-columns=NAME:.metadata.name,STATE:.status.state,COMPLETED:.status.completed

# Trigger an on-demand PXC backup.
[doc('Trigger an on-demand PXC backup')]
pxc-backup-now:
    @echo "Creating on-demand PXC backup..."
    kubectl apply -n pxc-clusters -f - <<< '{"apiVersion":"pxc.percona.com/v1","kind":"PerconaXtraDBClusterBackup","metadata":{"generateName":"on-demand-","namespace":"pxc-clusters"},"spec":{"pxcCluster":"mysql","storageName":"s3-backup"}}'

# Connect to MySQL via the HAProxy service (requires mysql client).
[doc('Open a MySQL shell via HAProxy')]
pxc-shell:
    @echo "Connecting to MySQL via HAProxy..."
    kubectl exec -n pxc-clusters -it mysql-haproxy-0 -- mysql -h 127.0.0.1 -u root -p

# ---------------------------------------------------------------------------
# Monitoring helpers
# ---------------------------------------------------------------------------

# Open Grafana in the default browser (requires tailnet access).
[doc('Open Grafana dashboard in browser')]
grafana-open:
    open "http://grafana.$(tailscale status --json | jq -r '.MagicDNSSuffix'):3000"

# Show Prometheus targets and their health.
[doc('List Prometheus scrape targets')]
prom-targets:
    kubectl -n monitoring exec -it svc/kube-prometheus-stack-prometheus -- \
      promtool query instant http://localhost:9090 'up'

# Port-forward Prometheus UI to localhost:9090 (for debugging).
[doc('Port-forward Prometheus UI to localhost:9090')]
prom-port-forward:
    kubectl -n monitoring port-forward svc/kube-prometheus-stack-prometheus 9090:9090

# Port-forward Grafana to localhost:3000 (fallback if tailnet is down).
[doc('Port-forward Grafana to localhost:3000')]
grafana-port-forward:
    kubectl -n monitoring port-forward svc/kube-prometheus-stack-grafana 3000:80

# Tail logs from the Prometheus operator.
[doc('Tail Prometheus operator logs')]
prom-operator-logs:
    kubectl -n monitoring logs -l app.kubernetes.io/name=prometheus-operator -f --tail=200

# Show all firing alerts.
[doc('Show all firing Prometheus alerts')]
alerts:
    kubectl -n monitoring exec -it svc/kube-prometheus-stack-prometheus -- \
      promtool query instant http://localhost:9090 'ALERTS{alertstate="firing"}'

# Check CNPG replication lag via Prometheus.
[doc('Query CNPG replication lag from Prometheus')]
cnpg-replication-lag:
    kubectl -n monitoring exec -it svc/kube-prometheus-stack-prometheus -- \
      promtool query instant http://localhost:9090 'cnpg_pg_replication_lag'

# ---------------------------------------------------------------------------
# ZFS monitoring helpers
# ---------------------------------------------------------------------------

# Show ZFS pool state from Prometheus.
[doc('Query ZFS pool state from Prometheus')]
zfs-pool-state:
    kubectl -n monitoring exec -it svc/kube-prometheus-stack-prometheus -- \
      promtool query instant http://localhost:9090 'node_zfs_zpool_state == 1'

# Show ZFS ARC hit ratio (5m average).
[doc('Query ZFS ARC hit ratio from Prometheus')]
zfs-arc-hit-ratio:
    kubectl -n monitoring exec -it svc/kube-prometheus-stack-prometheus -- \
      promtool query instant http://localhost:9090 'rate(node_zfs_arc_hits[5m]) / (rate(node_zfs_arc_hits[5m]) + rate(node_zfs_arc_misses[5m]))'

# Show ZFS ARC size vs max.
[doc('Query ZFS ARC size and target max from Prometheus')]
zfs-arc-size:
    kubectl -n monitoring exec -it svc/kube-prometheus-stack-prometheus -- \
      promtool query instant http://localhost:9090 '{__name__=~"node_zfs_arc_size|node_zfs_arc_c_max"}'
