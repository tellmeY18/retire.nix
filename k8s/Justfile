    kubectl logs -n cnpg-system -l app.kubernetes.io/name=cloudnative-pg -f --tail=200

# Tail logs from the current CNPG primary.
cnpg-primary-logs:
    kubectl logs -n cnpg-clusters -l cnpg.io/cluster=postgres,role=primary -f --tail=200

# Trigger an on-demand backup.
cnpg-backup-now:
    kubectl cnpg backup postgres -n cnpg-clusters

# List Backup objects with their phase.
cnpg-backup-list:
    kubectl get backup -n cnpg-clusters \
      -o custom-columns=NAME:.metadata.name,PHASE:.status.phase,STARTED:.status.startedAt,STOPPED:.status.stoppedAt

# ---------------------------------------------------------------------------
# mysql-ghost (MySQL Group Replication) day-2 helpers
# ---------------------------------------------------------------------------

# Show MGR group membership (primary + secondaries).
[doc('Show mysql-ghost MGR group members')]
mgr-status:
    kubectl exec -n mysql-ghost mysql-ghost-a-0 -c mysql -- sh -c \
      'mysql -uroot -p"$MYSQL_ROOT_PASSWORD" -e "SELECT member_host,member_state,member_role FROM performance_schema.replication_group_members;"' 2>/dev/null \
      || kubectl exec -n mysql-ghost mysql-ghost-b-0 -c mysql -- sh -c 'mysql -uroot -p"$MYSQL_ROOT_PASSWORD" -e "SELECT member_host,member_state,member_role FROM performance_schema.replication_group_members;"'

# Show ProxySQL backend routing (writer HG10 / reader HG20).
[doc('Show proxysql-ghost backend routing')]
mgr-routing:
    kubectl exec -n mysql-ghost deploy/proxysql-ghost -- \
      mysql -uradmin -p"$(kubectl get secret -n mysql-ghost mysql-ghost-gr -o jsonpath='{.data.radmin_password}' | base64 -d)" \
      -h127.0.0.1 -P6032 -e "SELECT hostgroup_id,hostname,status FROM runtime_mysql_servers ORDER BY hostgroup_id;"

# ---------------------------------------------------------------------------
# RustFS (S3-compatible object storage) day-2 helpers
