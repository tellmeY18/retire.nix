      wget -qO- "http://localhost:8428/api/v1/query?query=(node_power_supply_energy_watthour%7Bpower_supply%3D%22BAT0%22%7D%20%2F%20node_power_supply_energy_full%7Bpower_supply%3D%22BAT0%22%7D)%20*%20100" | jq '.data.result[]'

# Show battery health (current full capacity vs design capacity).
[doc('Query battery health (%) for all nodes')]
battery-health:
    kubectl -n monitoring exec -it deploy/vmks-victoria-metrics-k8s-stack-vmsingle -- \
      wget -qO- "http://localhost:8428/api/v1/query?query=(node_power_supply_energy_full%7Bpower_supply%3D%22BAT0%22%7D%20%2F%20node_power_supply_energy_full_design%7Bpower_supply%3D%22BAT0%22%7D)%20*%20100" | jq '.data.result[]'

# Show remaining battery energy in watt-hours.
[doc('Query remaining battery energy (Wh) for all nodes')]
battery-energy:
    kubectl -n monitoring exec -it deploy/vmks-victoria-metrics-k8s-stack-vmsingle -- \
      wget -qO- "http://localhost:8428/api/v1/query?query=node_power_supply_energy_watthour%7Bpower_supply%3D%22BAT0%22%7D" | jq '.data.result[]'

# ---------------------------------------------------------------------------
# Apache Answer helpers
# ---------------------------------------------------------------------------

# Show Answer deployment status.
[doc('Show Answer deployment status')]
answer-status:
    kubectl get deploy,pods,svc,ingress -n answer -o wide

# Tail Answer logs.
[doc('Tail Answer logs')]
answer-logs:
    kubectl logs -n answer -l app.kubernetes.io/name=answer -f --tail=200

# Restart Answer.
[doc('Restart Answer (rolling)')]
answer-restart:
    kubectl rollout restart deploy/answer -n answer

# Port-forward Answer to localhost:9080.
[doc('Port-forward Answer to localhost:9080')]
answer-port-forward:
    kubectl -n answer port-forward svc/answer-svc 9080:80

# Extract config.yaml from running Answer pod (for ConfigMap).
[doc('Extract config.yaml from Answer pod')]
answer-extract-config:
    #!/usr/bin/env bash
    set -euo pipefail
    POD=$(kubectl get pods -n answer -l app.kubernetes.io/name=answer -o jsonpath='{.items[0].metadata.name}')
    echo "Extracting config from pod: $POD"
    kubectl cp "answer/$POD:/data/conf/config.yaml" ./clusters/glug-infra/answer/extracted-config.yaml
    echo "\u2713 Saved to clusters/glug-infra/answer/extracted-config.yaml"
    echo "  Review it, then paste into configmap.yaml and uncomment the volume mount in deployment.yaml"

# Apply Answer credentials (sops-decrypt).
[doc('Apply Answer credentials Secret (sops-decrypt)')]
answer-apply-secret:
    @echo "Decrypting and applying Answer credentials..."
    sops --decrypt clusters/glug-infra/answer/credentials-secret.enc.yaml | kubectl apply -f -

# ---------------------------------------------------------------------------
# Tuwunel (Matrix homeserver) day-2 helpers
# ---------------------------------------------------------------------------

# Show Tuwunel StatefulSet + pod status.
[doc('Show Tuwunel StatefulSet + pod status')]
conduit-status:
    kubectl get statefulset,pods,svc,ingress -n conduit -o wide

# Tail Tuwunel logs.
[doc('Tail Tuwunel logs')]
conduit-logs:
    kubectl logs -n conduit -l app.kubernetes.io/name=conduit -f --tail=200

# Port-forward Tuwunel to localhost:8008.
[doc('Port-forward Tuwunel to localhost:8008 (for testing)')]
conduit-port-forward:
    kubectl -n conduit port-forward svc/conduit-svc 8008:8008

# Create the first admin user in Tuwunel.
# Usage: just k8s::conduit-create-admin <username> <password>
[doc('Create Tuwunel admin user: <username> <password>')]
conduit-create-admin username password:
    kubectl -n conduit port-forward svc/conduit-svc 8008:8008 &
    sleep 2; curl -s -X POST -H "Content-Type: application/json" \
      -d '{"username":"{{ username }}","password":"{{ password }}","admin":true}' \
      "http://localhost:8008/_matrix/client/v3/register"; \
    kill %1 2>/dev/null

# Apply Tuwunel credentials Secret (sops-decrypt).
[doc('Apply Tuwunel credentials Secret (sops-decrypt)')]
conduit-apply-secret:
    @echo "Decrypting and applying Tuwunel credentials..."
    sops --decrypt clusters/glug-infra/conduit/credentials-secret.enc.yaml | kubectl apply -f -
