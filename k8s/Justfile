# k8s/Justfile — recipes for the glug-infra cluster.
#
# Invoke from the repo root via the `k8s` module:
#   just k8s              # list these recipes
#   just k8s::apply       # apply everything
# or directly from this directory:
#   cd k8s && just apply
#
# Why a separate Justfile?
#   helm-secrets resolves `secrets://...` URLs in helmfile.yaml relative to
#   the CURRENT WORKING DIRECTORY. By making `k8s/` the working directory
#   for every recipe in this file we avoid sprinkling `cd k8s &&` over each
#   helmfile invocation, and let users in the k8s/ subtree drive everything
#   without typing `--file ../helmfile.yaml`.
#
# Pin the working directory so all recipes (helmfile, kubectl -k, sops)
# resolve relative paths against `k8s/` regardless of where `just` is run.
set working-directory := '.'

# List available commands
default:
    @just --list

# ---------------------------------------------------------------------------
# Apply / diff / template
# ---------------------------------------------------------------------------

# Apply all k8s cluster resources (kustomize + helmfile).
#
# Order matters:
#   1. kustomize creates the Namespaces (with PSA labels), NetworkPolicies,
#      and Tailscale LoadBalancer Services. These contain NO CRD-dependent
#      resources — only core Kubernetes types (Namespace, NetworkPolicy,
#      Service).
#   2. helmfile installs the victoria-metrics-k8s-stack (CRDs + operator +
#      VMSingle + VMAgent + Grafana), then CNPG operator, then Postgres
#      cluster, then PXC operator + MySQL cluster.
#   3. AFTER helmfile (CRDs are now in place), kustomize applies the
#      monitoring custom resources (VMRule, VMPodScrape, VMServiceScrape).
#      These require the VM operator CRDs to exist.
[doc('Apply kustomize + helmfile to the cluster')]
apply:
    kubectl apply -k clusters/glug-infra
    kubectl apply -k clusters/glug-infra/pxc
    kubectl apply -k clusters/glug-infra/rustfs
    kubectl apply -f clusters/glug-infra/monitoring/namespace.yaml
    helmfile sync
    kubectl apply -k clusters/glug-infra/monitoring

# Preview k8s changes without applying.
[doc('Preview kustomize + helmfile changes (no apply)')]
diff:
    kubectl diff -k clusters/glug-infra || true
    kubectl diff -k clusters/glug-infra/pxc || true
    kubectl diff -k clusters/glug-infra/rustfs || true
    kubectl diff -k clusters/glug-infra/monitoring || true
    helmfile diff

# Render the fully-merged helm output (values.yaml + decrypted secrets.yaml)
# without touching the cluster. Useful to confirm sensitive overrides are
# coming through before the first apply.
[doc('Render merged helm output (values + decrypted secrets)')]
template:
    helmfile template

# ---------------------------------------------------------------------------
# Secrets
# ---------------------------------------------------------------------------

# Edit a sops-encrypted secret file (path is relative to k8s/).
# Examples:
#   just k8s::edit-secret apps/postgres/secrets.yaml
#   just k8s::edit-secret apps/victoria-metrics-k8s-stack/secrets.yaml
[doc('Open a sops-encrypted file in $EDITOR')]
edit-secret path:
    sops {{ path }}

# Encrypt a plaintext values file in place (first-time setup only).
# After this runs, use `edit-secret` for subsequent edits.
# Example:
#   just k8s::encrypt-secret apps/victoria-metrics-k8s-stack/secrets.yaml
[doc('Encrypt a plaintext values file in place (first-time)')]
encrypt-secret path:
    sops --encrypt --in-place {{ path }}

# ---------------------------------------------------------------------------
# CNPG day-2 helpers
# ---------------------------------------------------------------------------
# All assume the kubectl-cnpg plugin is installed:
#   kubectl krew install cnpg

# Show the CNPG cluster status.
cnpg-status:
    kubectl cnpg status postgres -n cnpg-clusters

# Tail logs from the CNPG operator.
cnpg-operator-logs:
    kubectl logs -n cnpg-system -l app.kubernetes.io/name=cloudnative-pg -f --tail=200

# Tail logs from the current CNPG primary.
cnpg-primary-logs:
    kubectl logs -n cnpg-clusters -l cnpg.io/cluster=postgres,role=primary -f --tail=200

# Trigger an on-demand backup.
cnpg-backup-now:
    kubectl cnpg backup postgres -n cnpg-clusters

# List Backup objects with their phase.
cnpg-backup-list:
    kubectl get backup -n cnpg-clusters \
      -o custom-columns=NAME:.metadata.name,PHASE:.status.phase,STARTED:.status.startedAt,STOPPED:.status.stoppedAt

# ---------------------------------------------------------------------------
# PXC (Percona XtraDB Cluster) day-2 helpers
# ---------------------------------------------------------------------------

# Show PXC cluster status.
[doc('Show Percona XtraDB Cluster status')]
pxc-status:
    kubectl get pxc mysql -n pxc-clusters -o wide

# Show detailed PXC cluster info.
[doc('Show detailed PXC cluster description')]
pxc-describe:
    kubectl describe pxc mysql -n pxc-clusters

# Tail logs from the PXC operator.
[doc('Tail PXC operator logs')]
pxc-operator-logs:
    kubectl logs -n pxc-system -l app.kubernetes.io/name=pxc-operator -f --tail=200

# Tail logs from the PXC primary (writer) node.
[doc('Tail PXC primary node logs')]
pxc-primary-logs:
    kubectl logs -n pxc-clusters mysql-pxc-0 -c pxc -f --tail=200

# Tail HAProxy logs.
[doc('Tail PXC HAProxy logs')]
pxc-haproxy-logs:
    kubectl logs -n pxc-clusters -l app.kubernetes.io/component=haproxy,app.kubernetes.io/instance=mysql -f --tail=200

# Show all PXC pods and their status.
[doc('List all PXC pods')]
pxc-pods:
    kubectl -n pxc-clusters get pods -l app.kubernetes.io/instance=mysql -o wide

# List PXC backup objects.
[doc('List PXC backup objects')]
pxc-backup-list:
    kubectl get pxc-backup -n pxc-clusters \
      -o custom-columns=NAME:.metadata.name,STATE:.status.state,COMPLETED:.status.completed

# Trigger an on-demand PXC backup.
[doc('Trigger an on-demand PXC backup')]
pxc-backup-now:
    @echo "Creating on-demand PXC backup..."
    kubectl apply -n pxc-clusters -f - <<< '{"apiVersion":"pxc.percona.com/v1","kind":"PerconaXtraDBClusterBackup","metadata":{"generateName":"on-demand-","namespace":"pxc-clusters"},"spec":{"pxcCluster":"mysql","storageName":"s3-backup"}}'

# Connect to MySQL via the HAProxy service (requires mysql client).
[doc('Open a MySQL shell via HAProxy')]
pxc-shell:
    @echo "Connecting to MySQL via HAProxy..."
    kubectl exec -n pxc-clusters -it mysql-haproxy-0 -- mysql -h 127.0.0.1 -u root -p

# ---------------------------------------------------------------------------
# RustFS (S3-compatible object storage) day-2 helpers
# ---------------------------------------------------------------------------

# Show the RustFS Tenant status.
[doc('Show RustFS Tenant status')]
rustfs-status:
    kubectl get tenant rustfs-storage -n rustfs-clusters -o wide

# Show detailed RustFS Tenant info.
[doc('Show detailed RustFS Tenant description')]
rustfs-describe:
    kubectl describe tenant rustfs-storage -n rustfs-clusters

# Tail logs from the RustFS operator.
[doc('Tail RustFS operator logs')]
rustfs-operator-logs:
    kubectl logs -n rustfs-system -l app.kubernetes.io/name=rustfs-operator -f --tail=200

# Tail logs from a specific RustFS pod (default: first pod).
[doc('Tail RustFS storage pod logs')]
rustfs-pod-logs pod="rustfs-storage-pool-0-0":
    kubectl logs -n rustfs-clusters {{ pod }} -f --tail=200

# Show all RustFS pods and their status.
[doc('List all RustFS pods')]
rustfs-pods:
    kubectl -n rustfs-clusters get pods -l rustfs.tenant=rustfs-storage -o wide

# Show RustFS PVCs and their capacity.
[doc('List all RustFS PVCs')]
rustfs-pvcs:
    kubectl -n rustfs-clusters get pvc -l rustfs.tenant=rustfs-storage \
      -o custom-columns=NAME:.metadata.name,STATUS:.status.phase,CAPACITY:.status.capacity.storage,STORAGECLASS:.spec.storageClassName

# Port-forward the RustFS S3 API to localhost:9000.
[doc('Port-forward RustFS S3 API to localhost:9000')]
rustfs-port-forward:
    kubectl -n rustfs-clusters port-forward svc/rustfs-storage-io 9000:9000

# Port-forward the RustFS Console UI to localhost:9001.
[doc('Port-forward RustFS Console UI to localhost:9001')]
rustfs-console:
    kubectl -n rustfs-clusters port-forward svc/rustfs-storage-console 9001:9001

# Test S3 API connectivity (requires aws cli or mc).
[doc('Test RustFS S3 API health via tailnet')]
rustfs-health:
    @echo "Testing S3 API health..."
    kubectl -n rustfs-clusters exec rustfs-storage-pool-0-0 -- wget -qO- http://localhost:9000/minio/health/live && echo " OK" || echo " FAILED"

# Apply the RustFS credentials Secret from sops-encrypted source.
# Use this after editing credentials with `just k8s::edit-secret`.
[doc('Apply sops-decrypted RustFS credentials Secret')]
rustfs-apply-secret:
    @echo "Decrypting and applying RustFS credentials..."
    sops --decrypt clusters/glug-infra/rustfs/credentials-secret.enc.yaml | kubectl apply -f -

# ---------------------------------------------------------------------------
# Monitoring helpers (VictoriaMetrics stack)
# ---------------------------------------------------------------------------

# Open Grafana in the default browser (requires tailnet access).
[doc('Open Grafana dashboard in browser')]
grafana-open:
    open "http://grafana.$(tailscale status --json | jq -r '.MagicDNSSuffix'):3000"

# Query VMSingle directly using curl (MetricsQL compatible).
# Usage: just vm-query 'up'
[doc('Query VMSingle with a MetricsQL expression')]
vm-query expr:
    kubectl -n monitoring exec -it deploy/vmks-victoria-metrics-k8s-stack-vmsingle -- \
      wget -qO- "http://localhost:8428/api/v1/query?query={{ expr }}" | jq .

# Show all firing alerts from VMAlert.
[doc('Show all firing alerts from VMAlert')]
alerts:
    kubectl -n monitoring exec -it deploy/vmks-victoria-metrics-k8s-stack-vmsingle -- \
      wget -qO- "http://localhost:8428/api/v1/query?query=ALERTS%7Balertstate%3D%22firing%22%7D" | jq '.data.result[]'

# Port-forward VMSingle UI to localhost:8428 (for debugging).
[doc('Port-forward VMSingle UI to localhost:8428')]
vm-port-forward:
    kubectl -n monitoring port-forward svc/vmks-victoria-metrics-k8s-stack-vmsingle 8428:8428

# Port-forward Grafana to localhost:3000 (fallback if tailnet is down).
[doc('Port-forward Grafana to localhost:3000')]
grafana-port-forward:
    kubectl -n monitoring port-forward svc/vmks-victoria-metrics-k8s-stack-grafana 3000:3000

# Tail logs from the VictoriaMetrics operator.
[doc('Tail VictoriaMetrics operator logs')]
vm-operator-logs:
    kubectl -n monitoring logs -l app.kubernetes.io/name=victoria-metrics-operator -f --tail=200

# Tail logs from VMAgent.
[doc('Tail VMAgent logs')]
vmagent-logs:
    kubectl -n monitoring logs -l app.kubernetes.io/name=vmagent -f --tail=200

# Tail logs from VMAlert.
[doc('Tail VMAlert logs')]
vmalert-logs:
    kubectl -n monitoring logs -l app.kubernetes.io/name=vmalert -f --tail=200

# Show VMAgent scrape targets.
[doc('Show VMAgent active scrape targets')]
vmagent-targets:
    kubectl -n monitoring exec -it deploy/vmks-victoria-metrics-k8s-stack-vmagent -- \
      wget -qO- "http://localhost:8429/api/v1/targets" | jq '.data.activeTargets | length'

# Check CNPG replication lag via VMSingle.
[doc('Query CNPG replication lag from VMSingle')]
cnpg-replication-lag:
    kubectl -n monitoring exec -it deploy/vmks-victoria-metrics-k8s-stack-vmsingle -- \
      wget -qO- "http://localhost:8428/api/v1/query?query=cnpg_pg_replication_lag" | jq '.data.result[]'

# ---------------------------------------------------------------------------
# ZFS monitoring helpers
# ---------------------------------------------------------------------------

# Show ZFS pool state from VMSingle.
[doc('Query ZFS pool state from VMSingle')]
zfs-pool-state:
    kubectl -n monitoring exec -it deploy/vmks-victoria-metrics-k8s-stack-vmsingle -- \
      wget -qO- "http://localhost:8428/api/v1/query?query=node_zfs_zpool_state%7Bstate%3D%22online%22%7D" | jq '.data.result[]'

# Show ZFS ARC hit ratio (5m average).
[doc('Query ZFS ARC hit ratio from VMSingle')]
zfs-arc-hit-ratio:
    kubectl -n monitoring exec -it deploy/vmks-victoria-metrics-k8s-stack-vmsingle -- \
      wget -qO- "http://localhost:8428/api/v1/query?query=rate(node_zfs_arc_hits%5B5m%5D)%20%2F%20(rate(node_zfs_arc_hits%5B5m%5D)%20%2B%20rate(node_zfs_arc_misses%5B5m%5D))" | jq '.data.result[]'

# Show ZFS ARC size vs max.
[doc('Query ZFS ARC size and target max from VMSingle')]
zfs-arc-size:
    kubectl -n monitoring exec -it deploy/vmks-victoria-metrics-k8s-stack-vmsingle -- \
      wget -qO- "http://localhost:8428/api/v1/query?query=%7B__name__%3D~%22node_zfs_arc_size%7Cnode_zfs_arc_c_max%22%7D" | jq '.data.result[]'

# ---------------------------------------------------------------------------
# Laptop battery monitoring helpers
# ---------------------------------------------------------------------------

# Show AC power status for all nodes (1 = on AC, 0 = on battery).
[doc('Query AC power status for all nodes')]
battery-ac-status:
    kubectl -n monitoring exec -it deploy/vmks-victoria-metrics-k8s-stack-vmsingle -- \
      wget -qO- "http://localhost:8428/api/v1/query?query=node_power_supply_online%7Bpower_supply%3D%22AC0%22%7D" | jq '.data.result[]'

# Show battery charge percentage for all nodes.
[doc('Query battery charge level (%) for all nodes')]
battery-level:
    kubectl -n monitoring exec -it deploy/vmks-victoria-metrics-k8s-stack-vmsingle -- \
      wget -qO- "http://localhost:8428/api/v1/query?query=(node_power_supply_energy_watthour%7Bpower_supply%3D%22BAT0%22%7D%20%2F%20node_power_supply_energy_full%7Bpower_supply%3D%22BAT0%22%7D)%20*%20100" | jq '.data.result[]'

# Show battery health (current full capacity vs design capacity).
[doc('Query battery health (%) for all nodes')]
battery-health:
    kubectl -n monitoring exec -it deploy/vmks-victoria-metrics-k8s-stack-vmsingle -- \
      wget -qO- "http://localhost:8428/api/v1/query?query=(node_power_supply_energy_full%7Bpower_supply%3D%22BAT0%22%7D%20%2F%20node_power_supply_energy_full_design%7Bpower_supply%3D%22BAT0%22%7D)%20*%20100" | jq '.data.result[]'

# Show remaining battery energy in watt-hours.
[doc('Query remaining battery energy (Wh) for all nodes')]
battery-energy:
    kubectl -n monitoring exec -it deploy/vmks-victoria-metrics-k8s-stack-vmsingle -- \
      wget -qO- "http://localhost:8428/api/v1/query?query=node_power_supply_energy_watthour%7Bpower_supply%3D%22BAT0%22%7D" | jq '.data.result[]'
