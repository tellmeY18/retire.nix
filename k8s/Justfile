# k8s/Justfile — recipes for the glug-infra cluster.
#
# Invoke from the repo root via the `k8s` module:
#   just k8s              # list these recipes
#   just k8s::apply       # apply everything
# or directly from this directory:
#   cd k8s && just apply
#
# Why a separate Justfile?
#   helm-secrets resolves `secrets://...` URLs in helmfile.yaml relative to
#   the CURRENT WORKING DIRECTORY. By making `k8s/` the working directory
#   for every recipe in this file we avoid sprinkling `cd k8s &&` over each
#   helmfile invocation, and let users in the k8s/ subtree drive everything
#   without typing `--file ../helmfile.yaml`.
#
# Pin the working directory so all recipes (helmfile, kubectl -k, sops)
# resolve relative paths against `k8s/` regardless of where `just` is run.
set working-directory := '.'

# List available commands
default:
    @just --list

# Quick cluster health check.
[doc('Show cluster health: nodes, releases, pods, services')]
status:
    #!/usr/bin/env bash
    set -euo pipefail
    echo "=== Nodes ==="
    kubectl get nodes -o wide
    echo ""
    echo "=== Helm Releases ==="
    helm list -A
    echo ""
    echo "=== Unhealthy Pods ==="
    BAD=$(kubectl get pods -A --no-headers | grep -v 'Running\|Completed')
    if [ -n "$BAD" ]; then
      echo "$BAD"
    else
      echo "All pods healthy ✓"
    fi
    echo ""
    echo "=== Public Services ==="
    for url in https://tellmey.fyi https://wiki.fosscell.org https://ask.kenobi.win; do
      STATUS=$(curl -so /dev/null -w "%{http_code}" --connect-timeout 5 "$url" 2>/dev/null || echo "TIMEOUT")
      printf "  %-30s %s\n" "$url" "$STATUS"
    done

# ---------------------------------------------------------------------------
# Kubeconfig (remote fetch from chopper over Tailscale)
# ---------------------------------------------------------------------------

# Fetch the k3s kubeconfig from chopper over Tailscale and rewrite the
# server URL so it works from any tailnet member (e.g. the MacBook).
# The file is saved to .direnv/kubeconfig (picked up by .envrc) AND
# to ~/.kube/chopper.yaml as a fallback.
[doc('Fetch kubeconfig from chopper via Tailscale')]
fetch-kubeconfig:
    #!/usr/bin/env bash
    set -euo pipefail
    REMOTE="vysakh@chopper"
    REMOTE_PATH="/etc/rancher/k3s/k3s.yaml"
    LOCAL_DIR="$(pwd)/.direnv"
    LOCAL_PATH="${LOCAL_DIR}/kubeconfig"
    FALLBACK="${HOME}/.kube/chopper.yaml"

    mkdir -p "${LOCAL_DIR}" "${HOME}/.kube"
    echo "Fetching kubeconfig from ${REMOTE}:${REMOTE_PATH}…"
    scp "${REMOTE}:${REMOTE_PATH}" "${LOCAL_PATH}"

    # Rewrite 127.0.0.1 → chopper so the apiserver is reachable over tailnet.
    if command -v sed &>/dev/null; then
      sed -i'' -e 's|https://127.0.0.1:6443|https://chopper:6443|g' "${LOCAL_PATH}"
    fi

    chmod 600 "${LOCAL_PATH}"
    cp "${LOCAL_PATH}" "${FALLBACK}"
    chmod 600 "${FALLBACK}"
    echo "✓ Kubeconfig saved to:"
    echo "    ${LOCAL_PATH}  (direnv)"
    echo "    ${FALLBACK}  (fallback)"
    echo "  cd into k8s/ to activate, or run: export KUBECONFIG=${FALLBACK}"

# ---------------------------------------------------------------------------
# Apply / diff / template
# ---------------------------------------------------------------------------

# Apply all k8s cluster resources (kustomize + helmfile).
#
# Order matters:
#   1. kustomize creates the Namespaces (with PSA labels), NetworkPolicies,
#      and Tailscale LoadBalancer Services. These contain NO CRD-dependent
#      resources — only core Kubernetes types (Namespace, NetworkPolicy,
#      Service). Changala (Deployment + ConfigMap) is also pure kustomize.
#   2. helmfile installs the victoria-metrics-k8s-stack (CRDs + operator +
#      VMSingle + VMAgent + Grafana), then CNPG operator, then Postgres
#      cluster, then PXC operator + MySQL cluster, then RustFS operator.
#   3. AFTER helmfile (CRDs are now in place), apply CRD-dependent resources:
#      - RustFS credentials Secret (sops-decrypted, must exist BEFORE Tenant)
#      - RustFS Tenant CR (requires rustfs.com/v1alpha1 Tenant CRD)
#      - Changala credentials Secret (sops-decrypted)
#      - Monitoring custom resources (VMRule, VMServiceScrape, dashboards)
[doc('Apply kustomize + helmfile to the cluster')]
apply:
    kubectl apply -k clusters/glug-infra
    kubectl apply -k clusters/glug-infra/kube-system
    @echo "Applying RustFS credentials (sops-decrypt) before the StatefulSet..."
    sops --decrypt clusters/glug-infra/rustfs/credentials-secret.enc.yaml | kubectl apply -f -
    kubectl apply -k clusters/glug-infra/rustfs
    kubectl apply -f clusters/glug-infra/monitoring/namespace.yaml
    helmfile sync
    @echo "Applying Ghost MGR DB secrets (sops-decrypt), then the cluster..."
    sops --decrypt clusters/glug-infra/mysql-ghost/credentials-secret.enc.yaml | kubectl apply -f -
    sops --decrypt clusters/glug-infra/mysql-ghost/proxysql-ghost-config-secret.enc.yaml | kubectl apply -f -
    kubectl apply -k clusters/glug-infra/mysql-ghost
    @echo "Applying MediaWiki standalone MySQL secrets (sops-decrypt), then the cluster..."
    sops --decrypt clusters/glug-infra/mysql-mediawiki/credentials-secret.enc.yaml | kubectl apply -f -
    kubectl apply -k clusters/glug-infra/mysql-mediawiki
    @echo "Applying Conduit (sops-decrypt credentials first)..."
    kubectl apply -k clusters/glug-infra/conduit
    sops --decrypt clusters/glug-infra/conduit/credentials-secret.enc.yaml | kubectl apply -f -
    @echo "Applying mobileapps..."
    kubectl apply -k clusters/glug-infra/mobileapps
    @echo "Applying wikifeeds..."
    kubectl apply -k clusters/glug-infra/wikifeeds
    kubectl apply -k clusters/glug-infra/monitoring

# Preview k8s changes without applying.
[doc('Preview kustomize + helmfile changes (no apply)')]
diff:
    kubectl diff -k clusters/glug-infra || true
    kubectl diff -k clusters/glug-infra/rustfs || true
    kubectl diff -k clusters/glug-infra/mysql-ghost || true
    kubectl diff -k clusters/glug-infra/mysql-mediawiki || true
    kubectl diff -k clusters/glug-infra/conduit || true
    kubectl diff -k clusters/glug-infra/mobileapps || true
    kubectl diff -k clusters/glug-infra/wikifeeds || true
    kubectl diff -k clusters/glug-infra/monitoring || true
    helmfile diff

# Upgrade all Helm releases gracefully. Handles stuck pending releases
# by rolling back before retrying. Use this instead of `apply` when
# bumping chart versions.
[doc('Upgrade all Helm releases (handles stuck releases)')]
upgrade:
    #!/usr/bin/env bash
    set -euo pipefail
    echo "=== Checking for stuck releases ==="
    STUCK=$(helm list -A --all --output json | jq -r '.[] | select(.status == "pending-install" or .status == "pending-upgrade") | "\(.name) \(.namespace)"')
    if [ -n "$STUCK" ]; then
      echo "Found stuck releases, fixing..."
      while IFS=' ' read -r name ns; do
        echo "  Fixing $name in $ns..."
        if [ "$(helm history "$name" -n "$ns" --output json | jq '.[0].revision')" = "1" ]; then
          helm uninstall "$name" -n "$ns" 2>/dev/null || true
        else
          helm rollback "$name" 0 -n "$ns" 2>/dev/null || true
        fi
      done <<< "$STUCK"
      sleep 3
    fi
    echo "=== Syncing all releases ==="
    helmfile sync
    echo "=== Verifying ==="
    helm list -A
    echo ""
    FAILED=$(helm list -A --all --output json | jq -r '.[] | select(.status != "deployed") | "\(.name) (\(.status))"')
    if [ -n "$FAILED" ]; then
      echo "⚠️  Some releases are not deployed:"
      echo "$FAILED"
      exit 1
    fi
    echo "✓ All releases deployed successfully"

# Rebuild the CirrusSearch index (parallel across all mediawiki pods).
# Only needed after OpenSearch pod restart — NOT after wiki edits.
# Takes ~3 min for ~1000 pages.
[doc('Rebuild MediaWiki search index (after OpenSearch restart)')]
reindex-search:
    #!/usr/bin/env bash
    set -euo pipefail
    PODS=$(kubectl get pods -n mediawiki -l app.kubernetes.io/name=mediawiki -o jsonpath='{.items[*].metadata.name}')
    POD_ARR=($PODS)
    TOTAL=1144
    N=${#POD_ARR[@]}
    CHUNK=$((TOTAL / N + 1))
    echo "Rebuilding search index across $N pods (~$CHUNK pages each)..."
    # Step 1: recreate index config
    kubectl exec -n mediawiki ${POD_ARR[0]} -c mediawiki -- \
      php /var/www/html/extensions/CirrusSearch/maintenance/UpdateSearchIndexConfig.php 2>&1 | grep -v "^Deprecated"
    # Step 2: parallel index
    for i in $(seq 0 $((N-1))); do
      FROM=$((i * CHUNK + 1))
      TO=$(( (i+1) * CHUNK ))
      [ $TO -gt $TOTAL ] && TO=$TOTAL
      echo "  ${POD_ARR[$i]}: pages $FROM-$TO"
      kubectl exec -n mediawiki ${POD_ARR[$i]} -c mediawiki -- \
        sh -c "nohup php /var/www/html/extensions/CirrusSearch/maintenance/ForceSearchIndex.php --skipLinks --indexOnSkip --fromId $FROM --toId $TO > /tmp/index.log 2>&1 &"
    done
    echo "✓ Indexing running in background on $N pods."
    echo "  Check progress: kubectl exec -n mediawiki <pod> -c mediawiki -- tail -3 /tmp/index.log"

# Warm MediaWiki caches (Redis + file cache) by rendering every page once.
# Run after deploy or Redis restart. Takes ~2 min for ~1000 pages.
[doc('Warm MediaWiki page caches (Redis + file)')]
precache-wiki:
    #!/usr/bin/env bash
    set -euo pipefail
    POD=$(kubectl get pods -n mediawiki -l app.kubernetes.io/name=mediawiki -o jsonpath='{.items[0].metadata.name}')
    echo "Warming caches via $POD..."
    # rebuildLocalisationCache — caches i18n messages
    kubectl exec -n mediawiki $POD -c mediawiki -- \
      php /var/www/html/maintenance/run.php rebuildLocalisationCache --force 2>&1 | grep -v "^Deprecated" | tail -3
    # Warm parser+file cache by requesting every page
    echo "Fetching all page titles..."
    PAGES=$(kubectl exec -n mediawiki $POD -c mediawiki -- \
      php /var/www/html/maintenance/run.php showSiteStats 2>/dev/null | grep -oP 'Total pages: \K[0-9]+')
    echo "Warming $PAGES pages (parallel across pods)..."
    kubectl exec -n mediawiki $POD -c mediawiki -- sh -c '
      php /var/www/html/maintenance/run.php runJobs --maxjobs=100 2>/dev/null
      php /var/www/html/maintenance/run.php rebuildFileCache 2>&1 | tail -5
    '
    echo "✓ Cache warmed. Subsequent anonymous page views are served from file cache (no PHP)."

