# Standalone, operator-free: a single StatefulSet pod `rustfs-0`, one
# ZFS-backed PVC, no erasure coding. Stable endpoint: rustfs-storage-io:9000.
# ---------------------------------------------------------------------------

# Show the RustFS StatefulSet + pod status.
[doc('Show RustFS StatefulSet + pod status')]
rustfs-status:
    kubectl get statefulset rustfs -n rustfs-clusters -o wide
    kubectl get pods -n rustfs-clusters -l app.kubernetes.io/name=rustfs -o wide

# Describe the RustFS pod (events, scheduling, probes).
[doc('Describe the RustFS pod')]
rustfs-describe:
    kubectl describe pod rustfs-0 -n rustfs-clusters

# Tail logs from the RustFS pod.
[doc('Tail RustFS pod logs')]
rustfs-pod-logs:
    kubectl logs -n rustfs-clusters rustfs-0 -f --tail=200

# Show the RustFS pod and its status.
[doc('List the RustFS pod')]
rustfs-pods:
    kubectl -n rustfs-clusters get pods -l app.kubernetes.io/name=rustfs -o wide

# Show the RustFS PVC and its capacity.
[doc('List the RustFS PVC')]
rustfs-pvcs:
    kubectl -n rustfs-clusters get pvc -l app.kubernetes.io/name=rustfs \
      -o custom-columns=NAME:.metadata.name,STATUS:.status.phase,CAPACITY:.status.capacity.storage,STORAGECLASS:.spec.storageClassName

# Port-forward the RustFS S3 API to localhost:9000.
[doc('Port-forward RustFS S3 API to localhost:9000')]
rustfs-port-forward:
    kubectl -n rustfs-clusters port-forward svc/rustfs-storage-io 9000:9000

# Check the RustFS pod is Ready and the Service has an endpoint.
[doc('Check RustFS readiness + endpoint')]
rustfs-health:
