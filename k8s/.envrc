# k8s/.envrc — auto-loaded by direnv when you cd into k8s/.
#
# Sets KUBECONFIG to the locally-cached chopper kubeconfig so that kubectl,
# helm, helmfile, k9s, and `just` recipes all target the glug-infra cluster
# without any manual `export`.
#
# First-time setup:
#   just k8s::fetch-kubeconfig    # SCP from chopper over Tailscale
#
# The kubeconfig is gitignored (contains a client cert + key).

# Resolve the kubeconfig path relative to this .envrc file.
KUBECONFIG_PATH="$(direnv_layout_dir)/kubeconfig"

# Fall back to a well-known location if the layout-dir copy doesn't exist.
if [[ ! -f "$KUBECONFIG_PATH" ]]; then
  KUBECONFIG_PATH="${HOME}/.kube/chopper.yaml"
fi

if [[ -f "$KUBECONFIG_PATH" ]]; then
  export KUBECONFIG="$KUBECONFIG_PATH"
  log_status "KUBECONFIG → $KUBECONFIG_PATH"
else
  log_error "Kubeconfig not found. Run: just k8s::fetch-kubeconfig"
fi
