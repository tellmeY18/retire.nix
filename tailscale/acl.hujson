// Tailscale ACL Policy — managed via GitOps.
//
// This file is the source of truth for the tailnet's access control policy.
// Changes here are synced to Tailscale on push to `develop` via the
// tailscale-acl.yml GitHub Actions workflow.
//
// Syntax: HuJSON (JSON with comments and trailing commas)
// Docs:   https://tailscale.com/kb/1018/acls
//
// IMPORTANT: When no "acls" section exists, Tailscale defaults to allow-all.
// Once you ADD an "acls" section, it becomes deny-by-default. For a personal
// homelab tailnet where k3s nodes use Tailscale as the CNI transport, the
// safest policy is to keep allow-all for members and only restrict tagged
// (automated) devices.
//
// Architecture:
//   - Homelab nodes (chopper, kenobi, c3po) run k3s with flannel over tailscale
//   - k8s operator creates ephemeral devices for LoadBalancers/Funnels
//   - CI runners join ephemerally with tag:ci to push to Attic
//   - Personal devices (MacBook, phone) access everything
{
	// ─── Tag Ownership ────────────────────────────────────────────────
	"tagOwners": {
		"tag:k8s":          ["autogroup:admin"],
		"tag:k8s-operator": ["autogroup:admin"],
		"tag:server":       ["autogroup:admin"],
		"tag:ci":           ["autogroup:admin"],
	},

	// ─── Node Attributes ──────────────────────────────────────────────
	// Funnel: allows k8s-tagged devices to expose services publicly.
	"nodeAttrs": [
		{
			"target": ["tag:k8s"],
			"attr":   ["funnel"],
		},
	],

	// ─── SSH Policy ───────────────────────────────────────────────────
	// Allow admin users to SSH into any device on the tailnet.
	"ssh": [
		{
			"action": "accept",
			"src":    ["autogroup:admin"],
			"dst":    ["autogroup:self"],
			"users":  ["autogroup:nonroot", "root"],
		},
	],

	// ─── Custom DERP map ──────────────────────────────────────────────
	// Self-hosted DERP relay on kenobi (public OCI IP), behind Traefik at
	// https://derp.tellmey.fyi. c3po is behind symmetric NAT, so kenobi↔c3po
	// can't go direct and relays via DERP; routing that through our own node
	// instead of Tailscale's throttled shared "blr" relay removes the
	// bottleneck on attic→RustFS, etcd, CNPG and MGR across that pair.
	//
	// OmitDefaultRegions:false keeps Tailscale's built-in DERPs as fallback.
	// DERPPort 443 = Traefik (TLS) in front of derper's HTTP :8080.
	// STUNPort -1 = no STUN on this node (derper runs with -stun=false).
	"derpMap": {
		"OmitDefaultRegions": false,
		"Regions": {
			"900": {
				"RegionID":   900,
				"RegionCode": "glug",
				"RegionName": "glug-infra (kenobi)",
				"Nodes": [
					{
						"Name":     "kenobi",
						"RegionID": 900,
						"HostName": "derp.tellmey.fyi",
						"DERPPort": 443,
						"STUNPort": -1,
					},
				],
			},
		},
	},
}
